VITE_API_URL=
# Leave VITE_API_URL empty in development (Vite proxies /api to http://localhost:4000).
# In production set it to your backend origin, e.g. https://nch-backend.onrender.com

# Supabase project (Settings → API). The anon key is safe to expose to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
