{
    "name": "neha-crockery-house-backend",
    "version": "1.0.0",
    "description": "Neha Crockery House — Backend API Server (Node.js + TypeScript + Express + PostgreSQL + Prisma)",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "build:render": "prisma generate && tsc",
        "start": "node dist/server.js",
        "start:prod": "prisma migrate deploy && node dist/server.js",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "prisma:seed": "ts-node prisma/seed.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "postinstall": "prisma generate"
    },
    "dependencies": {
        "@prisma/client": "^5.14.0",
        "@supabase/supabase-js": "^2.117.2",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-async-errors": "^3.1.1",
        "express-rate-limit": "^7.3.1",
        "helmet": "^7.1.0",
        "morgan": "^1.10.0",
        "multer": "^2.0.0",
        "slugify": "^1.6.6",
        "winston": "^3.13.0",
        "xlsx": "^0.18.5",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^2.0.0",
        "@types/node": "^20.14.2",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^7.13.0",
        "@typescript-eslint/parser": "^7.13.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "prettier": "^3.3.2",
        "prisma": "^5.14.0",
        "supertest": "^7.0.0",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.4.5",
        "vitest": "^2.1.8"
    },
    "prisma": {
        "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
    }
}
