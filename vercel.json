{
  "buildCommand": "",
  "outputDirectory": ".",
  "installCommand": "",
  "redirects": [
    {
      "source": "/frontend/admin",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/frontend/admin/:path*",
      "destination": "/admin/:path*",
      "permanent": true
    },
    {
      "source": "/frontend",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/frontend/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/frontend/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/frontend/:page(about|products|product|brands|taroba|catalogue|contact|privacy|terms).html",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/frontend/:page(about|products|product|brands|taroba|catalogue|contact|privacy|terms)",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/:page(about|products|product|brands|taroba|catalogue|contact|privacy|terms).html",
      "destination": "/:page",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nehacrockery.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://nehacrockery.onrender.com/uploads/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/:path*"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/about",
      "destination": "/frontend/about.html"
    },
    {
      "source": "/products",
      "destination": "/frontend/products.html"
    },
    {
      "source": "/product",
      "destination": "/frontend/product.html"
    },
    {
      "source": "/brands",
      "destination": "/frontend/brands.html"
    },
    {
      "source": "/taroba",
      "destination": "/frontend/taroba.html"
    },
    {
      "source": "/catalogue",
      "destination": "/frontend/catalogue.html"
    },
    {
      "source": "/contact",
      "destination": "/frontend/contact.html"
    },
    {
      "source": "/privacy",
      "destination": "/frontend/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/frontend/terms.html"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/:path*"
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://checkout.razorpay.com\")"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-src 'self' https://api.razorpay.com https://checkout.razorpay.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|svg|png|jpg|jpeg|webp|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://checkout.razorpay.com\")"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-src 'self' https://api.razorpay.com https://checkout.razorpay.com https://www.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self';"
        }
      ]
    }
  ]
}

